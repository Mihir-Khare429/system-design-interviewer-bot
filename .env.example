# ── Recall.ai ──────────────────────────────────────────────────────────────────
# Get a free developer key at https://www.recall.ai/
RECALL_API_KEY=your_recall_api_key_here

# ── OpenAI ─────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── LLM backend ────────────────────────────────────────────────────────────────
# To use Ollama locally: install Ollama, run `ollama pull llama3.2`, then set:
#   LLM_BASE_URL=http://host.docker.internal:11434/v1
#   LLM_MODEL=llama3.2
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_VISION_MODEL=gpt-4o

# ── TTS backend ────────────────────────────────────────────────────────────────
# Kokoro (local Docker): TTS_BASE_URL=http://kokoro:8880/v1  TTS_VOICE=af_bella
# OpenAI: TTS_BASE_URL=https://api.openai.com/v1  TTS_VOICE=onyx
TTS_BASE_URL=http://kokoro:8880/v1
TTS_VOICE=af_bella

# ── ngrok ──────────────────────────────────────────────────────────────────────
# Free authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=your_ngrok_authtoken_here

# ── App ────────────────────────────────────────────────────────────────────────
PORT=8000
WEBHOOK_BASE_URL=https://YOUR_NGROK_SUBDOMAIN.ngrok-free.app
BOT_PERSONA_NAME=System Design Interviewer

# ── Database ───────────────────────────────────────────────────────────────────
# Local dev (SQLite — no setup required):
DATABASE_URL=sqlite+aiosqlite:///./sdi.db
# Production (Railway Postgres — Railway injects DATABASE_URL automatically when
# you provision a Postgres plugin; override the aiosqlite driver:):
#   DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ── Auth ───────────────────────────────────────────────────────────────────────
# REQUIRED in production: generate with `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=dev-secret-change-me-in-prod

# ── CORS ───────────────────────────────────────────────────────────────────────
# Set to your Vercel deployment URL in production (e.g. https://sdi.vercel.app).
# STRIPE_SUCCESS_URL and STRIPE_CANCEL_URL are auto-derived from this value.
FRONTEND_ORIGIN=http://localhost:3000

# ── Plan limits ────────────────────────────────────────────────────────────────
FREE_MONTHLY_INTERVIEWS=3
PRO_MONTHLY_INTERVIEWS=1000

# ── Admin ──────────────────────────────────────────────────────────────────────
# Comma-separated emails that are auto-promoted to admin on signup/signin.
# Admins bypass quota and see "admin" badge in the navbar.
ADMIN_EMAILS=

# ── Stripe ─────────────────────────────────────────────────────────────────────
# Leave blank to disable billing endpoints (pricing page still renders; upgrade
# button returns 503 gracefully).
# Keys:  https://dashboard.stripe.com/test/apikeys
# Price: create a $19/mo recurring price → paste the price_id below.
# Webhook (local): stripe listen --forward-to localhost:8000/api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
# Optional — auto-derived from FRONTEND_ORIGIN if left blank:
# STRIPE_SUCCESS_URL=https://your-app.vercel.app/dashboard?upgraded=1
# STRIPE_CANCEL_URL=https://your-app.vercel.app/pricing
